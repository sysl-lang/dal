// A dynamic numeric tower for sysl: machine integers that grow into big integers, exact rationals and
// doubles, with the promotion and demotion between them chosen by a policy value.
//
// This is the block a consumer writes to reach it:
//
//     dependencies {
//       dal { git = "github.com/sysl-lang/dal", version = "0.1.0" }
//     }
//
// The coordinate names the package, `dal`; the module a program imports is `sh.sysl.dal`. It
// declares no dependencies of its own -- everything it needs is the standard library's `sysl.math`,
// `sysl.math.bigint` and `sysl.math.rational`.

package {
  name    = "dal"
  version = "0.1.0"

  // 0.1.0-alpha.2 is the first release whose `sysl.math.rational` this is built on: `checked_of`,
  // `from_real` and the exact `cmp_real` that cross-kind comparison rests on.
  sysl = "0.1.0-alpha.2"
}

// **`heap = true`** because a `BigInt` and a `Rational` are heap values: any operation that leaves the
// 64-bit fast path allocates. Nothing here opens, reads or writes anything, so there is no `os`.
requires {
  heap = true
}
